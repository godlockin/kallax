{
  "name": "kallax",
  "version": "3.9.1",
  "description": "KALLAX - Knowledge-Augmented Leveraged Learning Agent eXecutor - Multi-Agent Collaboration Framework",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "node"
  ],
  "scripts": {
    "version:check": "bash scripts/build-tools/version-check.sh",
    "prebuild": "npm run version:check",
    "prebuild:rust": "npm run version:check",
    "prebuild:all": "npm run version:check",
    "build": "npm run build -w node",
    "build:rust": "cd rust && cargo build --release",
    "build:all": "npm run build:rust && npm run build",
    "audit:kpi": "bash scripts/audit/kpi-snapshot.sh",
    "pretest": "bash scripts/audit/kpi-snapshot.sh --build-only",
    "test": "npm run test -w node",
    "test:rust": "cd rust && cargo test",
    "test:all": "npm run test:rust && npm run test",
    "lint": "npm run lint -w node",
    "clean": "rm -rf node/dist rust/target",
    "start": "npm run start -w node",
    "web": "npm run web -w node",
    "cli-rule": "bash scripts/cli-rule \"$@\"",
    "cli-rule:setup": "bash scripts/cli-rule setup",
    "cli-rule:install": "bash scripts/cli-rule install --non-interactive",
    "cli-rule:verify": "bash scripts/cli-rule verify",
    "cli-rule:uninstall": "bash scripts/cli-rule uninstall --backup"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "collaboration",
    "framework",
    "conductor-performer",
    "claude-code"
  ],
  "author": "",
  "license": "MIT"
}
