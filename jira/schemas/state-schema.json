{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kallax.dev/schemas/state-schema.json",
  "title": "KALLAX State Schema",
  "description": "Validates status enums for ticket/epic/phase state machines (v2.7.4 D5 secondary status 1:1 验证). Single source of truth for all status values across jira/ JSON files.",
  "type": "object",
  "definitions": {
    "ticketStatus": {
      "description": "Ticket lifecycle status (8 primary + 4 secondary per ticket-schema.md)",
      "type": "string",
      "enum": [
        "backlog",
        "analysis",
        "ready",
        "gate_review",
        "in_progress",
        "test",
        "pr_review",
        "done",
        "blocked",
        "pending",
        "deferred",
        "failed"
      ]
    },
    "epicStatus": {
      "description": "EPIC lifecycle status (6 states per epic-state-machine.md: planning → active → blocked → done → archived → closed)",
      "type": "string",
      "enum": [
        "planning",
        "active",
        "blocked",
        "done",
        "archived",
        "closed"
      ]
    },
    "phaseStatus": {
      "description": "Phase lifecycle status (aligned with epic-state-machine.md 6-state machine)",
      "type": "string",
      "enum": [
        "planning",
        "active",
        "blocked",
        "done",
        "archived",
        "closed"
      ]
    },
    "priority": {
      "description": "Priority levels (P0 highest → P3 lowest)",
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "taskType": {
      "description": "Task types per ticket-schema.md",
      "type": "string",
      "enum": [
        "feature",
        "bug",
        "chore",
        "docs",
        "test",
        "refactor",
        "perf",
        "security"
      ]
    },
    "ticketId": {
      "description": "Ticket ID format: {EPIC|PHASE|TASK}-XXX or {EPIC|PHASE}-XXX-{LETTER}",
      "type": "string",
      "pattern": "^(EPIC|PHASE|TASK)-[0-9]+(-[A-Z])?$"
    },
    "epicId": {
      "description": "EPIC ID format: EPIC-NNN",
      "type": "string",
      "pattern": "^EPIC-[0-9]+$"
    },
    "phaseId": {
      "description": "Phase ID format: PHASE-NNN",
      "type": "string",
      "pattern": "^PHASE-[0-9]+$"
    },
    "isoDate": {
      "description": "ISO-8601 date (YYYY-MM-DD)",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "isoDateTime": {
      "description": "ISO-8601 datetime (YYYY-MM-DDTHH:MM:SSZ)",
      "type": "string",
      "format": "date-time"
    },
    "fileScope": {
      "description": "KALLAX file scope (includes + excludes glob patterns)",
      "type": "object",
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}