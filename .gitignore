# KALLAX .gitignore

# ============================================================
# 系统数据
# ============================================================
.kallax/data/
.kallax/logs/
.kallax/queue/
.kallax/instances/
.kallax/state/*
# Exception: allow config templates (*.yml) in state/, but keep runtime state (*.json) ignored
# Reason: instance_config.yml 是 config template, 新 clone 必须有; state.json / mode.json 是 runtime 不应 tracked
!.kallax/state/*.yml
!.kallax/state/*.yaml
.kallax/*.db
.kallax/inbox/*.processed
# Legacy double-nested .kallax/.kallax/ (early EKET 残留, 非主路径, 主路径在 .kallax/state/)
.kallax/.kallax/
# EKET runtime state (SQLite db, 跟 .kallax/*.db 同质)
.eket/
.eket/*.db
# Same paths under node/ (跟 EPIC-053-A l3-l4-consistency.sh 落地一致, 跟 EPIC-053-B 联动)
**/.kallax/data/
**/.kallax/*.db

# ============================================================
# Worktrees
# ============================================================
.claude/worktrees/
.kallax/worktrees/
.worktrees/
performer-EPIC-*/

# ============================================================
# 构建产物
# ============================================================
# Rust
rust/target/

# Node.js
node/dist/
node/node_modules/
node_modules/

# opencode (跟 v2.7.1 整理 release 联合, 跟 Rule 5 DRY 联合: .opencode/command symlink 到 .claude/commands, 防御 build artifacts 跟 lock file 误 commit)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/.gitignore

# ============================================================
# IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# 日志
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# 测试
# ============================================================
coverage/
.nyc_output/
*.lcov

# ============================================================
# 环境
# ============================================================
.env
.env.local
.env.*.local
*.env

# ============================================================
# 密钥（绝对禁止提交）
# ============================================================
*.pem
*.key
*.crt
*.p12
credentials.json
secrets.yml
secrets.yaml

# ============================================================
# 临时文件
# ============================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================================
# 输出
# ============================================================
output/
dist/
build/

# ============================================================
# 包管理锁文件（可选保留）
# ============================================================
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# Cargo.lock

# ============================================================
# 文档生成
# ============================================================
docs/_build/
site/

# ============================================================
# Docker
# ============================================================
docker-compose.override.yml
.docker/

# ============================================================
# k8s
# ============================================================
*.kubeconfig

# ============================================================
# Benchmarks (EPIC-016 init 性能, runtime artifacts)
# ============================================================
.kallax/benchmarks/

# ============================================================
# KALLAX Onramp test artifacts (T7 集成测试 fixture 跑过的 stub, 跟"反讽" 联合)
# ============================================================
ONRAMP-onramp-test-*.md
ONRAMP-testproj-*.md
ONRAMP-.-*.md

# ============================================================
# Performer runtime artifacts (跟"翻篇&精进" + "迭代证据" 联合)
# - DB 文件: 历史删掉不占空间 (filter-repo 已执行), .kallax/*.db 仍 ignore
# - ticket pass-report/test-output: 保留作为迭代证据 (主公 2026-06-17 explicit 派单)
# - test_result*.json: 暂 ignore (Performer 临时中间产物, 不作为迭代证据)
# - *.tmp: 临时文件 ignore
# ============================================================
jira/tickets/**/test_result*.json
jira/tickets/**/*.tmp

# KALLAX runtime artifacts (跟"翻篇&精进" 战略 一致, 跟 v1.3.3 ONRAMP-test-* 模式 一致)
.kallax/audit/
.kallax/inbox/
