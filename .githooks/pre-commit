#!/usr/bin/env bash
# KALLAX Pre-Commit Hook (EPIC-131-B)
# Triggered BEFORE commit — 5-Level Verify L1+L2 enforcement
#
# 主公抓的真问题 (2026-07-20):
#   "死代码 + 类型错误等等不被调用到不会暴露"
#
# 治根:
#   L1 git:     必须 staged 包含 src/ 改动
#   L2 stdout:  tsc strict mode 0 errors
#   sentinel:   scripts/scan-dead-code.sh 跑过

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GREEN='\033[1;32m'; RED='\033[1;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

log_ok()   { echo -e "${GREEN}[OK]${NC}   $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err()  { echo -e "${RED}[ERR]${NC}  $*"; }

# Skip if commit message indicates --no-verify bypass
COMMIT_MSG_FILE="${1:-.git/COMMIT_EDITMSG}"
if [ -f "$COMMIT_MSG_FILE" ] && grep -qE '\[skip-precommit\]|no-verify' "$COMMIT_MSG_FILE" 2>/dev/null; then
  log_warn "Pre-commit skipped (commit message indicates --no-verify intent)"
  exit 0
fi

# Stage must have CHANGES (skip if no changes)
if git diff --cached --quiet; then
  log_warn "Nothing staged, skipping pre-commit"
  exit 0
fi

# 1. If src files staged, run dead-code sentinel (cheap fail-fast)
STAGED_SRC=$(git diff --cached --name-only | grep -E '^node/src/.*\.ts$' || true)
if [ -n "$STAGED_SRC" ]; then
  log_ok "Staged src/ files detected: $(echo "$STAGED_SRC" | wc -l | tr -d ' ') files"
  if [ -x scripts/scan-dead-code.sh ]; then
    log_ok "Running scripts/scan-dead-code.sh (epic-131-B dead-code sentinel)..."
    if ! bash scripts/scan-dead-code.sh check; then
      log_err "Dead-code sentinel FAILED — fix dead code / tsc errors / module coverage before committing"
      log_err "  Tip: bash scripts/scan-dead-code.sh  (诊断)"
      log_err "  Tip: bash scripts/scan-dead-code.sh --help  (用法)"
      exit 1
    fi
    log_ok "Dead-code sentinel: PASS"
  else
    log_warn "scripts/scan-dead-code.sh not executable, skipping sentinel scan"
  fi
else
  log_ok "No src/.ts staged, skipping tsc/sentinel check"
fi

# 2. CLAUDE.md Rule 9 follow-up: PR must have raw test output in description (L5)
# Don't fail commit on this; we warn only (PR review catches)
log_warn "REMINDER: PR description must include raw 'npx tsc' + 'npx vitest run' output per CLAUDE.md 5-Level Verify L2+L4"

log_ok "Pre-commit hook passed"
exit 0
