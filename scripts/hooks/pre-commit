#!/usr/bin/env bash
# KALLAX Git Hook — Protect miao from direct code changes.
# Conductor: can merge feature→testing, create PR testing→miao
# Master:    approves PR testing→miao, tags release
# Performer: can only work on feature/*
# Install: bash scripts/hooks/install.sh
#
# EPIC-022-B: Added authz/check.sh + conductor-scope-check.sh integration
#             for miao.write authorization + conductor scope validation
set -euo pipefail

# SIGTERM handler (P0 fix: prevent session_start.sh style hang)
cleanup() {
  echo "DEBUG: pre-commit hook received SIGTERM" >&2
  exit 130
}
trap cleanup SIGTERM

# ── EPIC-110: exemption 三档 (bypass 4 immutable-law hooks) ─────────
# 1. KALLAX_HOOK_BYPASS=1  主公明确批准
# 2. CI=1                  CI 环境跑
# 3. commit message 以 "WIP" 开头   work-in-progress
HOOK_BYPASS=0
if [[ "${KALLAX_HOOK_BYPASS:-0}" == "1" ]]; then
  echo "WARN: pre-commit bypass via KALLAX_HOOK_BYPASS=1" >&2
  HOOK_BYPASS=1
elif [[ "${CI:-0}" == "1" || "${CI:-}" == "true" ]]; then
  echo "WARN: pre-commit bypass via CI=1" >&2
  HOOK_BYPASS=1
elif [[ -n "${COMMIT_MSG_FILE:-}" && -f "${COMMIT_MSG_FILE:-}" ]]; then
  _first_line="$(head -1 "$COMMIT_MSG_FILE" 2>/dev/null || echo '')"
  if [[ "$_first_line" =~ ^WIP ]]; then
    echo "WARN: pre-commit bypass via WIP commit" >&2
    HOOK_BYPASS=1
  fi
fi

BRANCH="$(git branch --show-current)"
ROLE_FILE=".kallax/state/instance_config.yml"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KALLAX_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
AUTHZ_CHECK="${KALLAX_ROOT}/scripts/permission/authz/check.sh"
CONDUCTOR_SCOPE_CHECK="${KALLAX_ROOT}/scripts/permission/conductor-scope-check.sh"

# ── Check 0: Authorization check via authz/check.sh (EPIC-022-B) ────────
# P0 fixes: fail-closed, set -euo pipefail, role name validation, fail-open fix

# Sanitize GIT_AUTHOR_NAME: strip control chars, prefix if empty/unset
_AUTHED_NAME="${GIT_AUTHOR_NAME:-}"
if [[ -z "$_AUTHED_NAME" ]]; then
  ACTOR_DISPLAY="unverified-unknown"
else
  # Remove carriage return, newline, null; keep printable + tab only
  ACTOR_DISPLAY="$(printf %s "$_AUTHED_NAME" | tr -d '\r\n\0' | LC_ALL=C tr -cd '[:print:]\t' || echo "unverified-sanitized")"
  if [[ -z "$ACTOR_DISPLAY" ]]; then
    ACTOR_DISPLAY="unverified-sanitized"
  fi
fi

# Missing or non-executable AUTHZ_CHECK = fail-closed (exit 1)
if [[ ! -x "$AUTHZ_CHECK" ]]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: AUTHZ_CHECK not found or not executable. ║"
  echo "║ ║"
  echo "║  Script: $AUTHZ_CHECK                           ║"
  echo "║ ║"
  echo "║  Run 'kallax install' to deploy authz hook.              ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# Branch-aware action mapping (跟 BE-23 联合 0 隐藏, 跟 EPIC-022-B 联合)
# miao branch → miao.write (conductor/master only)
# feature/* branch → worktree.commit (performer allowed)
# 其他 branch → miao.write (default fail-closed)
case "$BRANCH" in
  miao)
    AUTHZ_ACTION="miao.write"
    ;;
  feature/*|fix/*|hotfix/*)
    AUTHZ_ACTION="worktree.commit"
    ;;
  *)
    AUTHZ_ACTION="miao.write"
    ;;
esac

if ! bash "$AUTHZ_CHECK" --action "$AUTHZ_ACTION" --actor "$ACTOR_DISPLAY"; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Authorization denied by authz check. ║"
  echo "║ ║"
  echo "║  Branch: $BRANCH (action: $AUTHZ_ACTION)              ║"
  echo "║  Actor:  $ACTOR_DISPLAY                               ║"
  echo "║ ║"
  echo "║  Run 'kallax role:check $AUTHZ_ACTION' for details. ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# ── Check 0.5: Conductor Scope Check (EPIC-022-B) ─────────────────────
# Focused validation: conductor can only do conductor-scope actions;
# conductor blocked from miao.write/miao.merge/release.tag.
# Mirrors node/src/permissions/conductor-scope.ts verifyScope() in bash.
# 跟 BE-23 branch-aware action mapping 联合
# 跟 BE-25 / BE-26 pre-commit hook governance 联合
# 跟 EPIC-022-A 3 Role Definition 联合
if [[ -x "$CONDUCTOR_SCOPE_CHECK" ]]; then
  if ! bash "$CONDUCTOR_SCOPE_CHECK" --action "$AUTHZ_ACTION" --actor "$ACTOR_DISPLAY"; then
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: Conductor scope check DENIED.                ║"
    echo "║ ║"
    echo "║  Branch: $BRANCH (action: $AUTHZ_ACTION)              ║"
    echo "║  Actor:  $ACTOR_DISPLAY                               ║"
    echo "║ ║"
    echo "║  Conductor cannot write miao, only assign tasks.       ║"
    echo "║  Run 'bash scripts/permission/whoami.sh' to see role.  ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    exit 1
  fi
else
  # P0: fail-closed if conductor-scope-check is missing (defense-in-depth)
  echo "WARN: conductor-scope-check.sh not found at $CONDUCTOR_SCOPE_CHECK — skipping" >&2
  # Note: not exit 1 here, since authz/check.sh above already enforces; this is a focused double-check
fi

# ── 3 模式 decision-gate (Rule 13) ─────────────────────────────────────
# Detect dangerous commit msg patterns; ask unless mode=manual
DECISION_GATE="${KALLAX_ROOT}/scripts/permission/decision-gate.sh"
if [[ -x "$DECISION_GATE" ]]; then
  # Read commit message (COMMIT_MSG_FILE set by git, fallback to git log)
  COMMIT_MSG_FILE="${COMMIT_MSG_FILE:-$(mktemp)}"
  if [[ -z "$COMMIT_MSG_FILE" ]] || [[ ! -f "$COMMIT_MSG_FILE" ]]; then
    COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
  else
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || git log -1 --pretty=%B 2>/dev/null || echo "")
  fi

  # Detect danger patterns in commit msg
  if echo "$COMMIT_MSG" | grep -qE "merge.*miao|push.*--force|rm -rf|reset --hard" 2>/dev/null; then
    CURRENT_MODE=$(jq -r '.mode // "ai-copilot"' "${KALLAX_ROOT}/.kallax/state/state.json" 2>/dev/null)
    if [[ "$CURRENT_MODE" != "manual" ]]; then
      DANGEROUS_CMD=$(echo "$COMMIT_MSG" | grep -oE "merge.*miao|push.*--force|rm -rf|reset --hard" 2>/dev/null | head -1)
      if bash "$DECISION_GATE" --action "danger.data_destruction" --cmd "$DANGEROUS_CMD" 2>&1; then
        : # ASK returned success (user approved) — continue
        true
      else
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: decision-gate detected dangerous operation. ║"
        echo "║ ║"
        echo "║  Pattern: $DANGEROUS_CMD                              ║"
        echo "║  Mode: $CURRENT_MODE                                    ║"
        echo "║  Run 'kallax mode:set --mode manual' to skip future asks. ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        exit 1
      fi
    fi
  fi
fi

# ── 3 anti-fab tools (Rule 10) ──────────────────────────────────────────
# Run on ALL branches to catch KPI falsification, test verbatim, scope creep
#
# BE-25 fix: check-scope-creep requires TICKET_ID positional arg.
# Detect TICKET_ID from (in order):
#   1. KALLAX_TICKET_ID env var (manual override)
#   2. Branch name (feature/EPIC-NNN-X-* → EPIC-NNN-X)
#   3. Commit message (if COMMIT_MSG_FILE readable)
# If no TICKET_ID found, skip scope-creep check (warn but don't fail).
ANTIFAB_FAILED=0
SCOPE_CREEP_TICKET_ID="${KALLAX_TICKET_ID:-}"
if [[ -z "$SCOPE_CREEP_TICKET_ID" ]]; then
  # Try branch name: feature/EPIC-NNN-X-...
  SCOPE_CREEP_TICKET_ID="$(echo "$BRANCH" | grep -oE 'EPIC-[0-9]+-[A-Z]+' | head -1 || true)"
fi
if [[ -z "$SCOPE_CREEP_TICKET_ID" ]]; then
  # Try commit message file (passed by git)
  if [[ -n "${COMMIT_MSG_FILE:-}" ]] && [[ -f "$COMMIT_MSG_FILE" ]]; then
    SCOPE_CREEP_TICKET_ID="$(grep -oE 'EPIC-[0-9]+-[A-Z]+' "$COMMIT_MSG_FILE" 2>/dev/null | head -1 || true)"
  fi
fi

for _tool in check-test-case-isolation check-kpi-precision check-scope-creep; do
  _tool_path="${KALLAX_ROOT}/scripts/verify/${_tool}.sh"
  if [[ -x "$_tool_path" ]]; then
    # check-scope-creep needs TICKET_ID; skip if not detected
    if [[ "$_tool" == "check-scope-creep" ]] && [[ -z "$SCOPE_CREEP_TICKET_ID" ]]; then
      echo "WARN: check-scope-creep skipped (no TICKET_ID detected from branch or env)" >&2
      continue
    fi
    if [[ "$_tool" == "check-scope-creep" ]]; then
      _tool_cmd="bash $_tool_path $SCOPE_CREEP_TICKET_ID"
    else
      _tool_cmd="bash $_tool_path"
    fi
    if ! eval "$_tool_cmd" >/dev/null 2>&1; then
      echo "╔══════════════════════════════════════════════════════════════╗"
      echo "║  BLOCKED: $_tool FAILED                            ║"
      echo "║  Run the tool manually to see details:                    ║"
      echo "║  bash scripts/verify/${_tool}.sh ║"
      echo "╚══════════════════════════════════════════════════════════════╝"
      ANTIFAB_FAILED=1
    fi
  fi
done
if [[ "$ANTIFAB_FAILED" -eq 1 ]]; then
  exit 1
fi

# ── EPIC-110: 4 immutable-law checks (decorative/narrative/fail-closed/self-heal) ──
# CLAUDE.md "4 不可更改 法律" — v3.6.0 起 script 存在, EPIC-110 接进 pre-commit hook
if [[ "$HOOK_BYPASS" -eq 0 ]]; then
  LAW_FAILED=0
  for _law in check-decorative-claim check-narrative check-fail-closed check-self-heal check-live-test-guard check-evidence-fake; do
    _law_path="${KALLAX_ROOT}/scripts/verify/${_law}.sh"
    if [[ -x "$_law_path" ]]; then
      if ! KALLAX_STAGED_ONLY=1 bash "$_law_path" >/dev/null 2>&1; then
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: $_law violation                    ║"
        echo "║  Run: bash scripts/verify/${_law}.sh          ║"
        echo "║  Bypass (主公 approval): KALLAX_HOOK_BYPASS=1 git commit ...  ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        LAW_FAILED=1
      fi
    fi
  done
  if [[ "$LAW_FAILED" -eq 1 ]]; then
    exit 1
  fi
fi

# ── EPIC-069-D: claim evidence gate ─────────────────────────────────────
# README/CHANGELOG numeric claims must cite raw test output; fail closed.
if [[ "$HOOK_BYPASS" -eq 0 ]]; then
  CLAIM_EVIDENCE_CHECK="${KALLAX_ROOT}/scripts/hooks/check-claim-evidence.sh"
  if [[ ! -x "$CLAIM_EVIDENCE_CHECK" ]] || ! KALLAX_STAGED_ONLY=1 bash "$CLAIM_EVIDENCE_CHECK"; then
    echo "BLOCKED: claim evidence check failed or is unavailable: $CLAIM_EVIDENCE_CHECK" >&2
    exit 1
  fi
fi

# ── EPIC-220: disclaimer audit (借鉴 prime-agent limit != success) ────────
# 扫 staged .md 的 trusted/sandbox/secure/safe 关键词, 必带 raw_output 引用.
if [[ "$HOOK_BYPASS" -eq 0 ]]; then
  DISCLAIMER_CHECK="${KALLAX_ROOT}/scripts/verify/check-disclaimer.sh"
  if [[ -x "$DISCLAIMER_CHECK" ]]; then
    _staged_md="$(git diff --cached --name-only --diff-filter=ACM -- '*.md' 2>/dev/null || true)"
    if [[ -n "$_staged_md" ]]; then
      if ! bash "$DISCLAIMER_CHECK" scan >/dev/null 2>&1; then
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: disclaimer 无 raw_output 引用 (EPIC-220)            ║"
        echo "║  Run: bash scripts/verify/check-disclaimer.sh scan           ║"
        echo "║  Bypass (主公 approval): KALLAX_HOOK_BYPASS=1 git commit ...  ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        exit 1
      fi
    fi
  fi
fi

# ── EPIC-219: CLAUDE.md / .claude/rules snapshot 提醒 ────────────────────
# 改治理文件前应打 snapshot tag, 便于 rollback. 仅提醒不阻塞 (advisory).
_staged_gov="$(git diff --cached --name-only --diff-filter=ACM \
  -- 'CLAUDE.md' '.claude/rules/*.md' 2>/dev/null || true)"
if [[ -n "$_staged_gov" ]]; then
  SNAPSHOT_SCRIPT="${KALLAX_ROOT}/scripts/verify/snapshot-claude-md.sh"
  if [[ -x "$SNAPSHOT_SCRIPT" ]]; then
    _recent_tag="$(git tag -l 'claude-md-pre-*' --sort=-creatordate | head -1)"
    if [[ -z "$_recent_tag" ]]; then
      echo "NOTE (EPIC-219): 正在改治理文件但无 snapshot tag."
      echo "  建议: bash scripts/verify/snapshot-claude-md.sh snapshot '<改什么>'"
      echo "  文件: $(echo "$_staged_gov" | tr '\n' ' ')"
    fi
  fi
fi

# ── EPIC-225: jargon black list (主公 2026-08-08 拍板 "以后都要禁止使用黑话") ─
# 扫 staged .md/.sh/.ts/.rs, 命中黑名单 fail-closed.
# 跟装饰性宣称区别: 装饰性宣称是宽松模式 (措辞扫描), jargon 是严格黑名单 (0 黑话).
# Baseline (跟 EPIC-223 1:1): 历史违规 (≤ 14eb7c4f) 划线, 新增强制.
if [[ "$HOOK_BYPASS" -eq 0 ]]; then
  JARGON_CHECK="${KALLAX_ROOT}/scripts/verify/check-jargon.sh"
  if [[ -x "$JARGON_CHECK" ]]; then
    _staged_jargon="$(git diff --cached --name-only --diff-filter=ACM \
      -- '*.md' '*.sh' '*.ts' '*.rs' 2>/dev/null || true)"
    if [[ -n "$_staged_jargon" ]]; then
      if ! bash "$JARGON_CHECK" --staged >/dev/null 2>&1; then
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: jargon violation (EPIC-225)                     ║"
        echo "║  Run: bash scripts/verify/check-jargon.sh --staged        ║"
        echo "║  List: jira/tickets/.jargon-blacklist.json                 ║"
        echo "║  Bypass (主公 approval): KALLAX_HOOK_BYPASS=1 git commit ... ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        # 输出具体违规位置
        bash "$JARGON_CHECK" --staged 2>&1 | head -30 || true
        exit 1
      fi
    fi
  fi
fi

# ── EPIC-223: 新 ticket schema gate ─────────────────────────────────────
# staged 的 ticket.json 若属 > archived_before 的 EPIC, 强制 required_fields.
if [[ "$HOOK_BYPASS" -eq 0 ]]; then
  TICKET_SCHEMA_CHECK="${KALLAX_ROOT}/scripts/verify/check-ticket-schema.sh"
  if [[ -x "$TICKET_SCHEMA_CHECK" ]]; then
    _staged_tickets="$(git diff --cached --name-only --diff-filter=ACM \
      -- 'jira/tickets/*/ticket.json' 2>/dev/null || true)"
    if [[ -n "$_staged_tickets" ]]; then
      _ticket_failed=0
      while IFS= read -r _tj; do
        [[ -n "$_tj" ]] || continue
        _epic="$(basename "$(dirname "$_tj")")"
        bash "$TICKET_SCHEMA_CHECK" "$_epic" >/dev/null 2>&1
        _rc=$?
        # exit 3 = ARCHIVED_SKIP (历史 EPIC, 不回溯) → 放行
        if [[ "$_rc" -eq 1 ]]; then
          echo "BLOCKED: $_epic ticket.json schema 不合规 (EPIC-223)"
          echo "  Run: bash scripts/verify/check-ticket-schema.sh $_epic"
          _ticket_failed=1
        fi
      done <<< "$_staged_tickets"
      if [[ "$_ticket_failed" -eq 1 ]]; then
        echo "  Bypass (主公 approval): KALLAX_HOOK_BYPASS=1 git commit ..."
        exit 1
      fi
    fi
  fi
fi

# ── Only enforce miao-specific rules on miao branch ───────────────────
if [ "$BRANCH" != "miao" ]; then
  exit 0
fi

# ── Check 1: Role validation ──────────────────────────────────────────
ROLE="unknown"
if [ -f "$ROLE_FILE" ]; then
  ROLE=$(grep -E '^\s*role:' "$ROLE_FILE" 2>/dev/null | awk '{print $2}' || echo "unknown")
fi

# Only conductor or master can operate on miao
if [ "$ROLE" != "conductor" ] && [ "$ROLE" != "master" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: You do not have permission on miao.              ║"
  echo "║                                                            ║"
  echo "║  Role detected: ${ROLE}                                   ║"
  echo "║                                                            ║"
  echo "║  Only Conductor or Master can operate on miao.             ║"
  echo "║  Performer must work in feature/* worktrees.               ║"
  echo "║                                                            ║"
  echo "║  Run /kallax-start to set your role correctly.             ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# ── Check 2: No direct code changes on miao ──────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# ── Check 2.5: Rule of 500 (EPIC-059-B, 跟 eket MASTER-RULES.md §6 Rule 8 联合) ──
# 借方法论 不借代码 (跟 EPIC-059-A 5 levels 模式 一致)
# 跟 Rule 13 3 模式 decision-gate 联合: codemod 或 Approved-Large-PR-By: <主公>
PR_SIZE_CHECK="${KALLAX_ROOT}/scripts/check-pr-size.sh"
if [ -x "$PR_SIZE_CHECK" ]; then
  STAGED_DIFF_STATS=$(git diff --cached --stat 2>/dev/null || true)
  if [ -n "$STAGED_DIFF_STATS" ]; then
    STAGED_INSERTIONS=$(echo "${STAGED_DIFF_STATS}" | tail -1 | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || echo "0")
    STAGED_DELETIONS=$(echo "${STAGED_DIFF_STATS}" | tail -1 | grep -oE '[0-9]+ deletion' | grep -oE '[0-9]+' || echo "0")
    NET_CHANGE=$(( ${STAGED_INSERTIONS:-0} + ${STAGED_DELETIONS:-0} ))
    if ! bash "$PR_SIZE_CHECK" --check-rule-of-500 --lines "$NET_CHANGE" >/dev/null 2>&1; then
      echo "╔══════════════════════════════════════════════════════════════╗"
      echo "║  BLOCKED: Rule of 500 触发 (EPIC-059-B)                     ║"
      echo "║                                                            ║"
      echo "║  净变更 ${NET_CHANGE} 行 触发 4 档分级:                      ║"
      echo "║    500-1000 → 必须 codemod 或 Approved-Large-PR-By         ║"
      echo "║    1000+    → 拒绝 commit, 推荐 EPIC 拆分                  ║"
      echo "║                                                            ║"
      echo "║  跟 eket MASTER-RULES.md §6 Rule 8 联合                    ║"
      echo "║  跟 Rule 13 3 模式 decision-gate 联合                       ║"
      echo "║                                                            ║"
      echo "║  解法: bash scripts/check-pr-size.sh --lines ${NET_CHANGE}  ║"
      echo "║        查看完整提示, 拆分 PR 或申请豁免                      ║"
      echo "╚══════════════════════════════════════════════════════════════╝"
      bash "$PR_SIZE_CHECK" --check-rule-of-500 --lines "$NET_CHANGE" || true
      exit 1
    fi
  fi
fi

# ── Check 2.6: Anti-Pattern Check (v2.7.4, 跟主公 '不埋坑' 5 原则 联合) ──
# 7 anti-patterns 硬性 校验, 治根 跟'反讽' 联合 反复 (跟 v2.7.4 整理 release 联合)
# 跟 v2.7.1 9 hard rules 模式 一致, 跟 v2.7.4 B1-3 治根 累计 联合
ANTI_PATTERNS_CHECK="${KALLAX_ROOT}/scripts/check-anti-patterns.sh"
if [ -x "$ANTI_PATTERNS_CHECK" ]; then
  if ! bash "$ANTI_PATTERNS_CHECK" >/dev/null 2>&1; then
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  WARN: Anti-Pattern Check 检测到 1+ errors (跟 v2.7.4 联合) ║"
    echo "║                                                            ║"
    echo "║  7 anti-patterns 硬性 校验:                                ║"
    echo "║    1. 4+ level up imports                                  ║"
    echo "║    2. legacy/ or deprecated/ dirs                          ║"
    echo "║    3. TODO + exit 0 stubs                                  ║"
    echo "║    4. Hardcoded /Users/ paths                              ║"
    echo "║    5. console.log in src/ (Rule 7)                         ║"
    echo "║    6. Files > 500 lines (Rule 8)                           ║"
    echo "║    7. OUTDATED marker in non-archive                       ║"
    echo "║                                                            ║"
    echo "║  跟主公 2026-06-19 '不埋坑' 5 原则 联合                       ║"
    echo "║                                                            ║"
    echo "║  解法: bash scripts/check-anti-patterns.sh                  ║"
    echo "║        查看完整提示, 修复 或 申请豁免                        ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    bash "$ANTI_PATTERNS_CHECK" || true
    # WARN 模式: 不 阻塞 commit, 跟"翻篇&精进" 战略 一致, 跟 跟主公 拍板 explicit 联合
  fi
fi

# Allowed: docs, config, CI, analysis artifacts, jira tickets/epics
# v2.3.0: added ^jira/ to fix --no-verify workaround (P1-1 EPIC-058 deferred ticket)
ALLOWED_PATTERNS=(
  '^docs/'
  '^\.claude/'
  '^\.github/'
  '^\.kallax/'
  '^scripts/hooks/'
  '^scripts/'                     # v2.7.4 — scripts dir 扩 (跟"反讽" 联合 治根 c091d92 --no-verify bypass)
  '^tests/'                       # v2.7.4 — tests dir 直 commit (跟"反讽" 联合 治根 c091d92 --no-verify bypass)
  '^web/'                         # v2.7.4 — web dashboard 部署就绪 (跟 EPIC-058-C 联合)
  '^jira/'                        # v2.3.0 — jira tickets/epics direct commits
  '^confluence/'                  # v2.7.4 — confluence decisions/reports direct commits (治根 c091d92 --no-verify bypass)
  '^CHANGELOG\.md$'
  '^README\.md$'
  '^RELEASE\.md$'
  '^CONTRIBUTING\.md$'
  '^AGENTS\.md$'
  '^CLAUDE\.md$'
  '^LICENSE$'
  '^\.gitignore$'
  '^docker-compose\.yml$'
  '^Dockerfile$'
  '^package-lock\.json$'
)

# ── Check 3: Build artifacts 防御 (跟 v2.7.0 整理 release + 外部项目 教训 联合) ──
# 治根: rust/target/ + node_modules/ + dist/ + build/ 等 build artifacts 不应进 git
#       一旦 commit 历史 需 filter-repo 改写 才能推 GH Enterprise (50MB 限制)
# 跟"反讽" 联合 治根 "build 假动作" (build artifact 跟 源码 混 跟)
# 跟"诚实修正" 联合 治根 ".gitignore 不够 需 hook 主动 防御"
# 跟 v2.7.0 整理 release 联合 (跟主公 2026-06-19 '整理 总结 经验教训' 派单 联合)
BLOCKED_ARTIFACT_PATTERNS=(
  '^rust/target/'                # Rust build artifacts
  '^target/'                     # Generic build artifacts (Cargo, Maven)
  '^node_modules/'               # npm/yarn
  '^node/dist/'                  # TypeScript build
  '^dist/'                       # Generic build output
  '^build/'                      # Generic build output
  '^__pycache__/'                # Python bytecode cache
  '^\.cargo/'                    # Cargo registry cache
  '^\.rustup/'                   # rustup toolchain cache
  '^vendor/'                     # Go/PHP/Node vendor
  '\.o$'                         # Compiled object
  '\.so$'                        # Shared object (Linux)
  '\.dylib$'                     # Shared object (macOS)
  '\.dll$'                       # Dynamic library (Windows)
  '\.exe$'                       # Windows executable
  '\.pyc$'                       # Python compiled
  '\.wasm$'                      # WebAssembly
  '\.map$'                       # Source map (dev only, not source)
  '\.min\.js$'                   # Minified JS (dev only)
  '\.min\.css$'                  # Minified CSS (dev only)
)

BLOCKED_ARTIFACTS=""
while IFS= read -r file; do
  blocked=false
  for pattern in "${BLOCKED_ARTIFACT_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      blocked=true
      break
    fi
  done
  if [ "$blocked" = true ]; then
    BLOCKED_ARTIFACTS="${BLOCKED_ARTIFACTS}  ${file}\n"
  fi
done <<< "$STAGED_FILES"

if [ -n "$BLOCKED_ARTIFACTS" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Build artifacts 检测 (Check 3, 跟 v2.7.0 整理 release 联合) ║"
  echo "║                                                            ║"
  echo "║  Build artifacts (rust/target/, node_modules/, dist/ 等) ║"
  echo "║  不应进 git — 已 .gitignore 但需 hook 主动 防御            ║"
  echo "║                                                            ║"
  echo "║  检测到 build artifacts:                                   ║"
  printf "%b" "$BLOCKED_ARTIFACTS"
  echo "║                                                            ║"
  echo "║  治根:                                                    ║"
  echo "║    1. .gitignore 已 含 (rust/target/ node_modules/ dist/ build/) ║"
  echo "║    2. 误 add: git reset HEAD <file> + .gitignore             ║"
  echo "║    3. 误 commit: git rm --cached <file> + commit amend     ║"
  echo "║    4. 已在 历史: filter-repo 改写 (GH Enterprise 50MB 限制)  ║"
  echo "║                                                            ║"
  echo "║  跟 v2.7.0 ACCUMULATED-LESSONS §15 整理 release 联合        ║"
  echo "║  跟'反讽' 联合 治根 'build 假动作'                          ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

BLOCKED_FILES=""
while IFS= read -r file; do
  allowed=false
  for pattern in "${ALLOWED_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      allowed=true
      break
    fi
  done
  if [ "$allowed" = false ]; then
    BLOCKED_FILES="${BLOCKED_FILES}  ${file}\\n"
  fi
done <<< "$STAGED_FILES"

if [ -n "$BLOCKED_FILES" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Direct code changes on miao are PROHIBITED.       ║"
  echo "║                                                            ║"
  echo "║  Code must flow through:                                   ║"
  echo "║    feature/<name> → testing → miao                          ║"
  echo "║                                                            ║"
  echo "║  Blocked files:                                            ║"
  printf "%b" "$BLOCKED_FILES"
  echo "║                                                            ║"
  echo "║  Conductor: create feature worktree, merge to testing.     ║"
  echo "║  Performer: develop in feature/ worktree.                  ║"
  echo "║  Master: approve release PR (testing → miao).              ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# ── Check 2.7: EPIC-181-A testing 分支保护 (跟 wrapper R2 互补) ──
# Wrapper R2 只在 PR 创建前校验 base, pre-commit Check 2.7 拦截直接 commit 到 testing
# 治根: 0 跳过 4-branch, testing 分支必须经 PR merge, 不接受直接 commit
if [ "$BRANCH" = "testing" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Direct commit to testing is PROHIBITED.           ║"
  echo "║                                                            ║"
  echo "║  Code must flow through PR (EPIC-181-A):                    ║"
  echo "║    feature/<name> → PR → testing                           ║"
  echo "║                                                            ║"
  echo "║  testing 是 UAT 集成验证分支, 必须 PR 进来:               ║"
  echo "║    1. 在 feature/* 分支开发                                 ║"
  echo "║    2. gh pr create --base testing --head <feature>         ║"
  echo "║    3. 等 CI + 集成测试通过                                  ║"
  echo "║    4. PR merge 自动落 testing                               ║"
  echo "║                                                            ║"
  echo "║  例外: --no-verify + 主公 explicit 批准 (CLAUDE.md §4)    ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

exit 0
