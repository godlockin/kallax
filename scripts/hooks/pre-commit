#!/usr/bin/env bash
# KALLAX Git Hook — Protect miao from direct code changes.
# Conductor: can merge feature→testing, create PR testing→miao
# Master:    approves PR testing→miao, tags release
# Performer: can only work on feature/*
# Install: bash scripts/hooks/install.sh
#
# EPIC-022-B: Added authz/check.sh integration for miao.write authorization
set -euo pipefail

# SIGTERM handler (P0 fix: prevent session_start.sh style hang)
cleanup() {
  echo "DEBUG: pre-commit hook received SIGTERM" >&2
  exit 130
}
trap cleanup SIGTERM

BRANCH="$(git branch --show-current)"
ROLE_FILE=".kallax/state/instance_config.yml"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KALLAX_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
AUTHZ_CHECK="${KALLAX_ROOT}/scripts/permission/authz/check.sh"

# ── Check 0: Authorization check via authz/check.sh (EPIC-022-B) ────────
# P0 fixes: fail-closed, set -euo pipefail, role name validation, fail-open fix

# Sanitize GIT_AUTHOR_NAME: strip control chars, prefix if empty/unset
_AUTHED_NAME="${GIT_AUTHOR_NAME:-}"
if [[ -z "$_AUTHED_NAME" ]]; then
  ACTOR_DISPLAY="unverified-unknown"
else
  # Remove carriage return, newline, null; keep printable + tab only
  ACTOR_DISPLAY="$(printf %s "$_AUTHED_NAME" | tr -d '\r\n\0' | LC_ALL=C tr -cd '[:print:]\t' || echo "unverified-sanitized")"
  if [[ -z "$ACTOR_DISPLAY" ]]; then
    ACTOR_DISPLAY="unverified-sanitized"
  fi
fi

# Missing or non-executable AUTHZ_CHECK = fail-closed (exit 1)
if [[ ! -x "$AUTHZ_CHECK" ]]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: AUTHZ_CHECK not found or not executable. ║"
  echo "║ ║"
  echo "║  Script: $AUTHZ_CHECK                           ║"
  echo "║ ║"
  echo "║  Run 'kallax install' to deploy authz hook.              ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

if ! bash "$AUTHZ_CHECK" --action miao.write --actor "$ACTOR_DISPLAY"; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Authorization denied by authz check. ║"
  echo "║ ║"
  echo "║  Action: miao.write                                        ║"
  echo "║  Actor: $ACTOR_DISPLAY                               ║"
  echo "║ ║"
  echo "║  Run 'kallax role:check miao.write' for details. ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# ── 3 模式 decision-gate (Rule 13) ─────────────────────────────────────
# Detect dangerous commit msg patterns; ask unless mode=manual
DECISION_GATE="${KALLAX_ROOT}/scripts/permission/decision-gate.sh"
if [[ -x "$DECISION_GATE" ]]; then
  # Read commit message (COMMIT_MSG_FILE set by git, fallback to git log)
  COMMIT_MSG_FILE="${COMMIT_MSG_FILE:-$(mktemp)}"
  if [[ -z "$COMMIT_MSG_FILE" ]] || [[ ! -f "$COMMIT_MSG_FILE" ]]; then
    COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
  else
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || git log -1 --pretty=%B 2>/dev/null || echo "")
  fi

  # Detect danger patterns in commit msg
  if echo "$COMMIT_MSG" | grep -qE "merge.*miao|push.*--force|rm -rf|reset --hard" 2>/dev/null; then
    CURRENT_MODE=$(jq -r '.mode // "ai-copilot"' "${KALLAX_ROOT}/.kallax/state/state.json" 2>/dev/null)
    if [[ "$CURRENT_MODE" != "manual" ]]; then
      DANGEROUS_CMD=$(echo "$COMMIT_MSG" | grep -oE "merge.*miao|push.*--force|rm -rf|reset --hard" 2>/dev/null | head -1)
      if bash "$DECISION_GATE" --action "danger.data_destruction" --cmd "$DANGEROUS_CMD" 2>&1; then
        : # ASK returned success (user approved) — continue
        true
      else
        echo "╔══════════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: decision-gate detected dangerous operation. ║"
        echo "║ ║"
        echo "║  Pattern: $DANGEROUS_CMD                              ║"
        echo "║  Mode: $CURRENT_MODE                                    ║"
        echo "║  Run 'kallax mode:set --mode manual' to skip future asks. ║"
        echo "╚══════════════════════════════════════════════════════════════╝"
        exit 1
      fi
    fi
  fi
fi

# ── 3 anti-fab tools (Rule 10) ──────────────────────────────────────────
# Run on ALL branches to catch KPI falsification, test verbatim, scope creep
ANTIFAB_FAILED=0
for _tool in check-test-case-isolation check-kpi-precision check-scope-creep; do
  _tool_path="${KALLAX_ROOT}/scripts/verify/${_tool}.sh"
  if [[ -x "$_tool_path" ]]; then
    if ! bash "$_tool_path" >/dev/null 2>&1; then
      echo "╔══════════════════════════════════════════════════════════════╗"
      echo "║  BLOCKED: $_tool FAILED                            ║"
      echo "║  Run the tool manually to see details:                    ║"
      echo "║  bash scripts/verify/${_tool}.sh ║"
      echo "╚══════════════════════════════════════════════════════════════╝"
      ANTIFAB_FAILED=1
    fi
  fi
done
if [[ "$ANTIFAB_FAILED" -eq 1 ]]; then
  exit 1
fi

# ── Only enforce miao-specific rules on miao branch ───────────────────
if [ "$BRANCH" != "miao" ]; then
  exit 0
fi

# ── Check 1: Role validation ──────────────────────────────────────────
ROLE="unknown"
if [ -f "$ROLE_FILE" ]; then
  ROLE=$(grep -E '^\s*role:' "$ROLE_FILE" 2>/dev/null | awk '{print $2}' || echo "unknown")
fi

# Only conductor or master can operate on miao
if [ "$ROLE" != "conductor" ] && [ "$ROLE" != "master" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: You do not have permission on miao.              ║"
  echo "║                                                            ║"
  echo "║  Role detected: ${ROLE}                                   ║"
  echo "║                                                            ║"
  echo "║  Only Conductor or Master can operate on miao.             ║"
  echo "║  Performer must work in feature/* worktrees.               ║"
  echo "║                                                            ║"
  echo "║  Run /kallax-start to set your role correctly.             ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

# ── Check 2: No direct code changes on miao ──────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Allowed: docs, config, CI, analysis artifacts, jira tickets/epics
# v2.3.0: added ^jira/ to fix --no-verify workaround (P1-1 EPIC-058 deferred ticket)
ALLOWED_PATTERNS=(
  '^docs/'
  '^\.claude/'
  '^\.github/'
  '^\.kallax/'
  '^scripts/hooks/'
  '^jira/'                        # v2.3.0 — jira tickets/epics direct commits
  '^CHANGELOG\.md$'
  '^README\.md$'
  '^RELEASE\.md$'
  '^CONTRIBUTING\.md$'
  '^AGENTS\.md$'
  '^CLAUDE\.md$'
  '^LICENSE$'
  '^\.gitignore$'
  '^docker-compose\.yml$'
  '^Dockerfile$'
  '^package-lock\.json$'
)

BLOCKED_FILES=""
while IFS= read -r file; do
  allowed=false
  for pattern in "${ALLOWED_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      allowed=true
      break
    fi
  done
  if [ "$allowed" = false ]; then
    BLOCKED_FILES="${BLOCKED_FILES}  ${file}\\n"
  fi
done <<< "$STAGED_FILES"

if [ -n "$BLOCKED_FILES" ]; then
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: Direct code changes on miao are PROHIBITED.       ║"
  echo "║                                                            ║"
  echo "║  Code must flow through:                                   ║"
  echo "║    feature/<name> → testing → miao                          ║"
  echo "║                                                            ║"
  echo "║  Blocked files:                                            ║"
  printf "%b" "$BLOCKED_FILES"
  echo "║                                                            ║"
  echo "║  Conductor: create feature worktree, merge to testing.     ║"
  echo "║  Performer: develop in feature/ worktree.                  ║"
  echo "║  Master: approve release PR (testing → miao).              ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

exit 0
